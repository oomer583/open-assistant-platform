# Uygulamanın tarayıcıda gösterilen adı.
NEXT_PUBLIC_APP_NAME=Open Assistant

# Hugging Face ayarları. Anahtarı https://huggingface.co/settings/tokens
# adresinden oluşturup gerçek değerini yalnızca .env.local dosyasına yazın.
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
